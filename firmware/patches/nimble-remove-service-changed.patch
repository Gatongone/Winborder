         .type = BLE_GATT_SVC_TYPE_PRIMARY,
         .uuid = BLE_UUID16_DECLARE(BLE_GATT_SVC_UUID16),
         .characteristics = (struct ble_gatt_chr_def[]) { {
+            /* ------------------------------------------------------------------
+             * Winborder patch: remove Service Changed (0x2A05).
+             *
+             * Database Hash (0x2B2A) sits behind #if MYNEWT_VAL(BLE_GATT_CACHING)
+             * further down, and this board does not enable GATT caching. The GATT
+             * service therefore advertised "Service Changed supported" without the
+             * Database Hash that BLE 5.1 pairs it with. That combination is not
+             * defined, and it left the central free to do as it liked with it.
+             *
+             * The symptom: the service discovery response carried all three
+             * services (0x1800/0x1801/0x1812) in one 20 byte packet at MTU 256 with
+             * rc = 0, and the central consistently parsed only the first two,
+             * dropping HID without a word.
+             *
+             * Enabling GATT caching to get the Database Hash back is not an option
+             * on NimBLE 2.5.1: ble_gatts.c declares `int i` twice and does not
+             * build, and a hand patched build crashes and reboots at power on.
+             *
+             * The cost: the device no longer announces that its attribute table
+             * changed, so a peer that cached an older table has to forget the
+             * device and pair again after a firmware update.
+             *
+             * To restore the stock behaviour, delete this comment and the #if 0 /
+             * #endif pair around the characteristic. The brace that opens the next
+             * characteristic is inside the pair, so the array still balances.
+             * ------------------------------------------------------------------ */
+#if 0
             .uuid = BLE_UUID16_DECLARE(BLE_SVC_GATT_CHR_SERVICE_CHANGED_UUID16),
             .access_cb = ble_svc_gatt_access,
             .val_handle = &ble_svc_gatt_changed_val_handle,
             .flags = BLE_GATT_CHR_F_INDICATE,
         },
         {
+#endif
             .uuid = BLE_UUID16_DECLARE(BLE_SVC_GATT_CHR_SERVER_SUPPORTED_FEAT_UUID16),
